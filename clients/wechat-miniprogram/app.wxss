    --td-gray-color-2: #ededf2;
    --td-gray-color-3: #e5e5ec;
    --td-gray-color-4: #d6d7e0;
    --td-gray-color-5: #c8c9d4;
    --td-gray-color-6: #a8aab8;
    --td-gray-color-7: #9093a3;
    --td-gray-color-8: #6d7080;
    --td-gray-color-9: #595c6e;
    --td-gray-color-10: #3d4052;
    --td-gray-color-11: #2b2d3a;
    --td-gray-color-12: #18181f;
    --td-gray-color-13: #111116;
    --td-gray-color-14: #08080b;
    --td-font-white-1: rgba(246, 246, 249, 0.9);
    --td-font-white-2: rgba(246, 246, 249, 0.55);
    --td-font-white-3: rgba(246, 246, 249, 0.35);
    --td-font-white-4: rgba(246, 246, 249, 0.22);
    --td-font-gray-1: rgba(18, 19, 22, 0.9);
    --td-font-gray-2: rgba(18, 19, 22, 0.6);
    --td-font-gray-3: rgba(18, 19, 22, 0.4);
    --td-font-gray-4: rgba(18, 19, 22, 0.26);
    /* 描边与遮罩 */
    --td-component-stroke: #2b2d3a;
    --td-component-border: #3d4052;
    --td-border-level-1-color: #2b2d3a;
    --td-border-level-2-color: #3d4052;
    --td-mask-active: rgba(4, 4, 6, 0.62);
    --td-mask-disabled: rgba(4, 4, 6, 0.70);
    /* 品牌与冷钛主色阶：7 为冷钛填充，8 为悬停，9/10 为暗底上的冷银前景色。 */
