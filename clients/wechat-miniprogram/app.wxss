/**
 * 全局样式：与 Web 后台共享「象牙瓷白 × 曜黑银刃（A2-Pro + 1A）」双态体系——浅色为主，系统暗色时由下方
 * @media (prefers-color-scheme: dark) 整套切换（app.json 开启 darkmode，导航栏与标签栏走 theme.json）。
 * --yumi-primary 只作填充与描边；图标和强调文字用前景强调色 --yumi-primary-deep（暗色为冷银蓝）。
 */
page {
  --yumi-canvas: #f5f4f0;
  --yumi-surface: #ffffff;
  --yumi-surface-soft: #f2f1ec;
  --yumi-surface-well: #e6e4dd;
  --yumi-ink: #121316;
  --yumi-body: #22242a;
  --yumi-muted: #5a5e6a;
  --yumi-hairline: #dad7cf;
  --yumi-hairline-strong: #c2bfb6;
  --yumi-primary: #18191f;
  --yumi-primary-pressed: #292b35;
  --yumi-primary-deep: #29497a;
  --yumi-primary-soft: #eeedf0;
  --yumi-primary-border: #c9c7cf;
  /* 光学材质：卡片顶边 1rpx 镜面高光、图标底托内凹、干净建筑卡片影。 */
  --yumi-facet-highlight: inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  --yumi-well-inset: inset 0 2rpx 4rpx rgba(20, 21, 25, 0.06);
  --yumi-shadow-card: 0 14rpx 32rpx -16rpx rgba(20, 21, 25, 0.14), var(--yumi-facet-highlight);
  --yumi-shadow-float: 0 10rpx 26rpx rgba(20, 21, 25, 0.18);
  /* 环境光晕：顶部极柔单源自然光，静态背景层，不压在文字上。 */
  --yumi-aura: radial-gradient(ellipse 92% 380rpx at 50% -40rpx, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0) 70%), radial-gradient(ellipse 68% 320rpx at 88% 0%, rgba(175, 168, 152, 0.12), rgba(175, 168, 152, 0) 72%);
  --yumi-sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  /* 五档字号：各页统一沿用这五档，靠字号与字重建立清晰阅读层次。 */
  --yumi-text-caption: 24rpx;
  --yumi-text-body: 28rpx;
  --yumi-text-emphasis: 32rpx;
  --yumi-text-title: 40rpx;
  --yumi-text-display: 48rpx;
  /* 可点卡片按下时的克制触感反馈。 */
  --yumi-press-scale: 0.985;

  /* TDesign 主色阶统一映射至钢琴黑曜与冷瓷灰体系：7 为主色，8 为按下，1/2 为浅底。 */
  --td-primary-color-1: #eeedf0;
  --td-primary-color-2: #dedde2;
  --td-primary-color-3: #c9c7cf;
  --td-primary-color-4: #a5a6b0;
  --td-primary-color-5: #787b87;
  --td-primary-color-6: #4b4e5a;
  --td-primary-color-7: #18191f;
  --td-primary-color-8: #292b35;
  --td-primary-color-9: #0c0d10;
  --td-primary-color-10: #050507;
  --td-brand-color: #18191f;
  --td-brand-color-active: #292b35;
  --td-brand-color-light: #eeedf0;
  --td-button-primary-color: #ffffff;
  --td-button-primary-outline-color: #18191f;
  --td-button-primary-outline-border-color: #18191f;
  --td-bg-color-page: #f5f4f0;
  --td-text-color-primary: #121316;
  --td-text-color-secondary: #22242a;
  --td-text-color-placeholder: #5a5e6a;
  --td-skeleton-bg-color: #e6e4dd;
  --td-collapse-panel-bg-color: #ffffff;
  --td-collapse-border-color: #dad7cf;
  --td-collapse-header-text-color: #121316;
  --td-collapse-content-text-color: #22242a;
  --td-collapse-icon-color: #5a5e6a;
  --td-swiper-nav-fraction-bg-color: rgba(18, 19, 22, 0.58);

  background-color: var(--yumi-canvas);
  background-image: var(--yumi-aura);
  background-repeat: no-repeat;
  color: var(--yumi-body);
  font-family: var(--yumi-sans);
  font-size: var(--yumi-text-body);
  line-height: 1.6;
}

/*
 * 曜黑银刃暗色（A2-Pro + 1A）：覆写全部 --yumi-* 与 TDesign 暗色语义基座。TDesign 1.17.0 的公共样式没有引入
 * theme/_dark.wxss，组件里大量 var(--td-*, 浅色字面量) 会退回白底，所以基座必须在这里整套显式写出
 * （tests/miniprogram/content.test.js 核对清单；本机装了 miniprogram_npm 时还会扫组件源码）。
 */
