    --td-component-border: #4a443c;
    --td-border-level-1-color: #36312c;
    --td-border-level-2-color: #4a443c;
    --td-mask-active: rgba(8, 7, 6, 0.6);
    --td-mask-disabled: rgba(8, 7, 6, 0.68);
    /* 品牌与主色阶：7 为填充主色，8 为悬停，9/10 为暗底上的前景色。 */
