/** 全局样式：浅灰底、白色卡片，页面底部为悬浮按钮或固定操作栏留出空间。 */
page {
  background: #f5f5f5;
  color: #1a1a1a;
  font-size: 28rpx;
}
.page { padding: 24rpx 24rpx 200rpx; box-sizing: border-box; }
.page--with-bar { padding-bottom: 220rpx; }
.card { background: #ffffff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.state { display: flex; flex-direction: column; align-items: center; gap: 24rpx; padding: 120rpx 0; }
.specs { display: flex; flex-wrap: wrap; gap: 12rpx; }
.section-title { display: block; font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.body-text { font-size: 28rpx; line-height: 1.7; color: #333333; white-space: pre-wrap; }
.ask-host { position: fixed; right: 32rpx; bottom: calc(32rpx + env(safe-area-inset-bottom)); z-index: 10; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: #ffffff; box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06); z-index: 10; }
