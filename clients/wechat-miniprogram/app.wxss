    --td-brand-color-disabled: #1d212e;
    --td-brand-color-focus: #171a24;
    --td-brand-color-light: #171a24;
    --td-brand-color-light-active: #202433;
    --td-primary-color-1: #171a24;
    --td-primary-color-2: #1f2331;
    --td-primary-color-3: #2d3345;
    --td-primary-color-4: #363d52;
    --td-primary-color-5: #44526d;
    --td-primary-color-6: #4c5b78;
    --td-primary-color-7: #536382;
