    --td-bg-color-container: #111116;
    --td-bg-color-container-active: #18181f;
    --td-bg-color-secondarycontainer: #18181f;
    --td-bg-color-secondarycontainer-active: #2b2d3a;
    --td-bg-color-component: #2b2d3a;
    --td-bg-color-component-active: #3d4052;
    --td-bg-color-component-disabled: #15161c;
    --td-bg-color-secondarycomponent: #3d4052;
    --td-bg-color-secondarycomponent-active: #595c6e;
    --td-bg-color-specialcomponent: transparent;
    /* 文字层级：品牌色文字与链接走冷银蓝前景。 */
