/* 页面内容区；底部为悬浮按钮或固定操作栏留出空间，避免遮住最后一项。 */
.page { padding: 32rpx 32rpx 200rpx; box-sizing: border-box; }
.page--with-bar { padding-bottom: 220rpx; }

.serif { font-family: var(--yumi-sans); font-weight: 600; }
.section-title { display: block; font-weight: 700; font-size: var(--yumi-text-title); line-height: 1.3; letter-spacing: -0.5rpx; color: var(--yumi-ink); margin-bottom: 24rpx; }
.body-text { font-size: var(--yumi-text-body); line-height: 1.85; color: var(--yumi-body); white-space: pre-wrap; }
.spec-line { font-size: var(--yumi-text-caption); line-height: 1.5; color: var(--yumi-muted); letter-spacing: 0.5rpx; }

/* 可点卡片的按下态：克制缩小加轻淡，140ms 过渡。 */
.pressable { transition: transform 140ms ease-out, opacity 140ms ease-out; }
.pressable.is-pressed { transform: scale(var(--yumi-press-scale)); opacity: 0.88; }

/* 加载、空、出错、下架共用的状态块：标题 + 说明 + 一个动作，居中排在首屏上半部。 */
.state { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 140rpx 48rpx 0; }
.state--compact { padding-top: 44rpx; }
.state__mark { width: 72rpx; height: 4rpx; border-radius: 999rpx; background: var(--yumi-primary); margin-bottom: 36rpx; }
.state__title { font-weight: 700; font-size: var(--yumi-text-title); line-height: 1.35; color: var(--yumi-ink); }
.state__body { margin-top: 18rpx; font-size: var(--yumi-text-body); line-height: 1.7; color: var(--yumi-muted); max-width: 520rpx; }
.state__action { margin-top: 48rpx; }

/* 「问管家」悬浮按钮：紧凑胶囊，靠右下；只在有内容时出现。 */
.ask-host { position: fixed; right: 32rpx; bottom: calc(40rpx + env(safe-area-inset-bottom)); z-index: 10; border-radius: 999rpx; box-shadow: var(--yumi-shadow-float); }

/* 原生客服按钮（open-type="contact"）去掉微信按钮的默认外观，权重与页面类一致。 */
.contact-reset { padding: 0; border-radius: 0; background: transparent; font-size: inherit; font-weight: inherit; line-height: inherit; text-align: left; color: inherit; }
.contact-reset::after { border: none; }
button.contact-reset:not([size=mini]) { width: auto; margin: 0; }

/* 详情页底部操作栏：纯白底 + 清晰暖石顶边。 */
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--yumi-surface); border-top: 1rpx solid var(--yumi-hairline); z-index: 10; }

/* 行尾箭头（t-icon 的 t-class 外部类）：与左侧强调图标同在一行，靠这个类单独压成弱化色。 */
.yumi-chevron { color: var(--yumi-muted); }
