/**
 * 全局样式：与 Web 后台共享「暖纸光学 × 暖炭光学」双态体系——浅色为主，系统暗色时由下方
 * @media (prefers-color-scheme: dark) 整套切换（app.json 开启 darkmode，导航栏与标签栏走 theme.json）。
 * --yumi-primary 只作填充与描边；图标和强调文字用前景强调色 --yumi-primary-deep（暗色为暖琥珀）。
 */
page {
  --yumi-canvas: #f6f4ee;
  --yumi-surface: #ffffff;
  --yumi-surface-soft: #f2eee6;
  --yumi-surface-well: #e8e2d7;
  --yumi-ink: #1c1916;
  --yumi-body: #282420;
  --yumi-muted: #575048;
  --yumi-hairline: #dad2c5;
  --yumi-hairline-strong: #c2b7a6;
  --yumi-primary: #c24322;
  --yumi-primary-pressed: #a73619;
  --yumi-primary-deep: #b53a1b;
  --yumi-primary-soft: #fbede8;
  --yumi-primary-border: #eabeb0;
  /* 光学材质：卡片顶边 1rpx 镜面高光、图标底托内凹、卡片轻切面阴影。 */
  --yumi-facet-highlight: inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  --yumi-well-inset: inset 0 2rpx 4rpx rgba(28, 25, 22, 0.06);
  --yumi-shadow-card: 0 4rpx 12rpx rgba(28, 25, 22, 0.04), var(--yumi-facet-highlight);
  --yumi-shadow-float: 0 8rpx 24rpx rgba(28, 25, 22, 0.16);
  --yumi-sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  /* 五档字号：各页统一沿用这五档，靠字号与字重建立清晰阅读层次。 */
  --yumi-text-caption: 24rpx;
  --yumi-text-body: 28rpx;
  --yumi-text-emphasis: 32rpx;
  --yumi-text-title: 40rpx;
  --yumi-text-display: 48rpx;
  /* 可点卡片按下时的克制触感反馈。 */
  --yumi-press-scale: 0.985;

  /* TDesign 主色阶统一映射至晶陶红体系：7 为主色，8 为按下，1/2 为浅底。 */
  --td-primary-color-1: #fbede8;
  --td-primary-color-2: #f5d6cc;
  --td-primary-color-3: #eabeb0;
  --td-primary-color-4: #df9e89;
  --td-primary-color-5: #d47d62;
  --td-primary-color-6: #cb5f3e;
  --td-primary-color-7: #c24322;
  --td-primary-color-8: #a73619;
  --td-primary-color-9: #8f2d14;
  --td-primary-color-10: #5c1c0b;
  --td-brand-color: #c24322;
  --td-brand-color-active: #a73619;
  --td-brand-color-light: #fbede8;
  --td-button-primary-color: #ffffff;
  --td-button-primary-outline-color: #b53a1b;
  --td-button-primary-outline-border-color: #c24322;
  --td-bg-color-page: #f6f4ee;
  --td-text-color-primary: #1c1916;
  --td-text-color-secondary: #282420;
  --td-text-color-placeholder: #575048;
  --td-skeleton-bg-color: #e8e2d7;
  --td-collapse-panel-bg-color: #ffffff;
  --td-collapse-border-color: #dad2c5;
  --td-collapse-header-text-color: #1c1916;
  --td-collapse-content-text-color: #282420;
  --td-collapse-icon-color: #575048;
  --td-swiper-nav-fraction-bg-color: rgba(28, 25, 22, 0.58);

  background: var(--yumi-canvas);
  color: var(--yumi-body);
  font-family: var(--yumi-sans);
  font-size: var(--yumi-text-body);
  line-height: 1.6;
}

/*
