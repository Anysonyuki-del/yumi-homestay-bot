    --td-warning-color: #f2b84b;
    --td-warning-color-1: #261d0d;
    --td-warning-color-2: #372a12;
    --td-warning-color-3: #5a4418;
    --td-warning-color-4: #86641f;
    --td-warning-color-5: #b08328;
    --td-warning-color-6: #d69f38;
    --td-warning-color-7: #f2b84b;
    --td-warning-color-8: #f5c872;
    --td-warning-color-9: #f8daa0;
