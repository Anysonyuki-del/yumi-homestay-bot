    --yumi-shadow-float: 0 12rpx 36rpx rgba(0, 0, 0, 0.78);
    --yumi-aura: radial-gradient(ellipse 88% 360rpx at 54% -40rpx, rgba(224, 234, 255, 0.10), rgba(224, 234, 255, 0) 70%), radial-gradient(ellipse 64% 300rpx at 88% 0%, rgba(148, 182, 255, 0.10), rgba(148, 182, 255, 0) 72%);

    /* 背景层级 */
