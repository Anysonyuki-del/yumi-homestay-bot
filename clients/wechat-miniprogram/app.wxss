    --yumi-primary: #536382;
    --yumi-primary-pressed: #44526d;
    --yumi-primary-deep: #b8cdf5;
    --yumi-primary-soft: #171a24;
    --yumi-primary-border: #363d52;
    --yumi-facet-highlight: inset 0 1rpx 0 rgba(255, 255, 255, 0.16);
