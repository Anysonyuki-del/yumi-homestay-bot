    --td-bg-color-container-active: #272420;
    --td-bg-color-secondarycontainer: #272420;
    --td-bg-color-secondarycontainer-active: #36312c;
    --td-bg-color-component: #36312c;
    --td-bg-color-component-active: #4a443c;
    --td-bg-color-component-disabled: #22201d;
    --td-bg-color-secondarycomponent: #4a443c;
    --td-bg-color-secondarycomponent-active: #665e55;
    --td-bg-color-specialcomponent: transparent;
    /* 文字层级：品牌色文字与链接走暖琥珀前景，不用填充用的晶陶红。 */
