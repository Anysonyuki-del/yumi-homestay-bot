<view class="page">
  <view wx:if="{{status === 'loading'}}" aria-label="正在加载房间">
    <view class="card" wx:for="{{[1, 2]}}" wx:key="*this"><t-skeleton row-col="{{skeletonRows}}" loading /></view>
  </view>
  <view wx:elif="{{status === 'error'}}" class="state">
    <t-empty icon="error-circle" description="{{message}}" />
    <t-button theme="primary" variant="outline" bind:tap="retry">重试</t-button>
  </view>
  <view wx:elif="{{status === 'empty'}}" class="state">
    <t-empty icon="info-circle" description="内容整理中，有问题请问管家" />
  </view>
  <block wx:else>
    <view class="card room-card" wx:for="{{rooms}}" wx:key="id" data-id="{{item.id}}" bindtap="openRoom" aria-role="button" aria-label="查看{{item.name}}">
      <image wx:if="{{item.cover}}" class="room-card__cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
      <view wx:else class="room-card__cover room-card__cover--empty">暂无照片</view>
      <view class="room-card__body">
        <text class="room-card__name">{{item.name}}</text>
        <view class="specs">
          <t-tag wx:if="{{item.bedType}}" variant="light" size="small">{{item.bedType}}</t-tag>
          <t-tag wx:if="{{item.maxGuests}}" variant="light" size="small">可住 {{item.maxGuests}} 人</t-tag>
          <t-tag wx:if="{{item.areaSqm}}" variant="light" size="small">{{item.areaSqm}} ㎡</t-tag>
        </view>
      </view>
    </view>
  </block>
  <view class="ask-host"><t-button theme="primary" shape="round" icon="chat" bind:tap="askHost">问管家</t-button></view>
</view>
