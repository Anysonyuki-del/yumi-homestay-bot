.room-card { padding: 0; overflow: hidden; }
.room-card__cover { display: block; width: 100%; height: 360rpx; background: #eeeeee; }
.room-card__cover--empty { display: flex; align-items: center; justify-content: center; color: #999999; font-size: 26rpx; }
.room-card__body { padding: 24rpx; }
.room-card__name { display: block; font-size: 34rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 16rpx; }
