<view class="page page--with-bar">
  <view wx:if="{{status === 'loading'}}" class="card" aria-label="正在加载房间详情"><t-skeleton row-col="{{skeletonRows}}" loading /></view>
  <view wx:elif="{{status === 'gone'}}" class="state">
    <t-empty icon="info-circle" description="{{message}}" />
    <t-button theme="primary" variant="outline" bind:tap="backToList">返回房间列表</t-button>
  </view>
  <view wx:elif="{{status === 'error'}}" class="state">
    <t-empty icon="error-circle" description="{{message}}" />
    <t-button theme="primary" variant="outline" bind:tap="retry">重试</t-button>
  </view>
  <block wx:else>
    <t-swiper wx:if="{{room.photos.length}}" class="photos" list="{{room.photos}}" height="480rpx" navigation="{{swiperNavigation}}" bind:click="previewPhoto" />
    <view class="card">
      <text class="room-name">{{room.name}}</text>
      <view class="specs">
        <t-tag wx:if="{{room.bedType}}" variant="light" size="small">{{room.bedType}}</t-tag>
        <t-tag wx:if="{{room.maxGuests}}" variant="light" size="small">可住 {{room.maxGuests}} 人</t-tag>
        <t-tag wx:if="{{room.areaSqm}}" variant="light" size="small">{{room.areaSqm}} ㎡</t-tag>
      </view>
    </view>
    <view wx:if="{{room.intro}}" class="card">
      <text class="section-title">房间介绍</text>
      <text class="body-text" user-select>{{room.intro}}</text>
    </view>
    <view wx:if="{{room.facilities.length}}" class="card">
      <text class="section-title">设施</text>
      <view class="specs"><t-tag wx:for="{{room.facilities}}" wx:key="*this" variant="outline" size="medium">{{item}}</t-tag></view>
    </view>
  </block>
  <view class="bottom-bar"><t-button theme="primary" block icon="chat" bind:tap="askHost">预订或咨询请问管家</t-button></view>
</view>
