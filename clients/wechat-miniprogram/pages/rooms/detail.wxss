/* 房间详情：照片满宽置顶，正文区块使用清晰暖石细线分隔，设施采用带顶边高光的细描边胶囊。 */
.detail { padding-bottom: 220rpx; }
.hero { display: block; --td-swiper-radius: 0; }
.hero--placeholder { height: 600rpx; background: var(--yumi-surface-well); }
.detail__body { padding: 36rpx 32rpx 0; }
.detail__head { padding-bottom: 36rpx; }
.detail__name { display: block; font-weight: 700; font-size: var(--yumi-text-display); line-height: 1.25; letter-spacing: -1rpx; color: var(--yumi-ink); margin-bottom: 12rpx; }
.detail__photo-note { display: block; margin-top: 16rpx; font-size: var(--yumi-text-caption); color: var(--yumi-muted); }
.detail__section { padding: 36rpx 0; border-top: 1rpx solid var(--yumi-hairline); }
.facilities { display: flex; flex-wrap: wrap; gap: 14rpx; }
.facility {
  padding: 12rpx 24rpx; border-radius: 999rpx;
  border: 1rpx solid var(--yumi-hairline); background: var(--yumi-surface);
  font-size: var(--yumi-text-caption); line-height: 1.4; color: var(--yumi-body);
  box-shadow: var(--yumi-facet-highlight);
}
