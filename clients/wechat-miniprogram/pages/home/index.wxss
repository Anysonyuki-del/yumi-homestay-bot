/* 首页：暖纸画布托起细描边光学切面卡片（暗色随系统切暖炭）；快捷导航一行四格；房间为 4:3 大图卡片与紧凑无图卡片。 */
.banner { display: block; margin-bottom: 40rpx; --td-swiper-radius: 24rpx; }
.banner--placeholder { height: 386rpx; border-radius: 24rpx; background: var(--yumi-surface-well); }

.store { margin: 8rpx 0 32rpx; }
.store__name { display: block; font-weight: 700; font-size: var(--yumi-text-display); line-height: 1.25; letter-spacing: -1rpx; color: var(--yumi-ink); }
.store-skeleton { height: 52rpx; width: 44%; border-radius: 10rpx; background: var(--yumi-surface-well); }
.store__notice { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.store__notice .store__intro { margin-top: 0; }
.store__intro {
  display: -webkit-box; margin-top: 12rpx; font-size: var(--yumi-text-body); line-height: 1.7; color: var(--yumi-muted);
  overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
}

/* 房间卡片：纯白 24rpx 卡片 + 1rpx 暖石细描边，与暖白画布层次清晰分明。 */
.room {
  display: flex; flex-direction: column; gap: 8rpx;
  margin-bottom: 28rpx; padding: 24rpx; border-radius: 24rpx;
  border: 1rpx solid var(--yumi-hairline); background: var(--yumi-surface); box-shadow: var(--yumi-shadow-card);
}
/* 卡片内容宽约 638rpx，按 4:3 取 478rpx 高；兼容旧基础库不依赖 aspect-ratio。 */
.room__media {
  position: relative; display: flex; align-items: center; justify-content: center;
  height: 478rpx; margin-bottom: 14rpx; border-radius: 18rpx; overflow: hidden; background: var(--yumi-surface-well);
}
.room__cover { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 200ms ease-out; }
.room__cover--loaded { opacity: 1; }
.room__name { font-weight: 700; font-size: var(--yumi-text-title); line-height: 1.3; color: var(--yumi-ink); }
.room__summary {
  display: -webkit-box; margin-top: 4rpx; font-size: var(--yumi-text-body); line-height: 1.65; color: var(--yumi-body);
  overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
}

/* 无封面或封面失效时的紧凑卡片：直接展示房名与规格，保持同一纯白卡片语言。 */
.room--compact { padding: 28rpx; margin-bottom: 24rpx; }
.room__photo-note { margin-top: 8rpx; font-size: var(--yumi-text-caption); color: var(--yumi-muted); letter-spacing: 1rpx; }

/* 加载占位与成品同形 */
.room-skeleton {
  margin-bottom: 28rpx; padding: 24rpx; border-radius: 24rpx;
  border: 1rpx solid var(--yumi-hairline); background: var(--yumi-surface); box-shadow: var(--yumi-shadow-card);
}
.room-skeleton__line { height: 26rpx; width: 52%; margin-top: 16rpx; border-radius: 8rpx; background: var(--yumi-surface-well); }
.room-skeleton__line--title { height: 40rpx; width: 40%; margin-top: 0; }

/* 快捷导航：细描边卡片内一行四格，每格图标落在内凹暖石底托上，图标继承这里的前景强调色。 */
.quick-nav {
  display: flex; margin-bottom: 48rpx; padding: 24rpx 12rpx;
  border-radius: 24rpx; border: 1rpx solid var(--yumi-hairline); background: var(--yumi-surface); box-shadow: var(--yumi-shadow-card);
}
.quick-nav__item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 8rpx 0; transition: opacity 140ms ease-out; }
.quick-nav__item--pressed { opacity: 0.65; }
.quick-nav__icon {
  display: flex; align-items: center; justify-content: center;
  width: 84rpx; height: 84rpx; border-radius: 20rpx; background: var(--yumi-surface-well);
  box-shadow: var(--yumi-well-inset); color: var(--yumi-primary-deep);
}
.quick-nav__label { font-size: var(--yumi-text-caption); font-weight: 500; line-height: 1.4; color: var(--yumi-ink); }

/* 「房间」标题与「共 N 间」同一行对齐 */
.rooms-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 20rpx; }
.rooms-head__title { margin-bottom: 0; }
.rooms-head__count { font-size: var(--yumi-text-caption); color: var(--yumi-muted); }

/* 页尾联系管家条：细描边切面卡片，视觉与服务页一致。 */
.contact {
  display: flex; align-items: center; gap: 24rpx; padding: 28rpx 32rpx; margin-top: 12rpx;
  border-radius: 24rpx; border: 1rpx solid var(--yumi-hairline); background: var(--yumi-surface); box-shadow: var(--yumi-shadow-card);
}
.contact__text { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.contact__title { font-weight: 700; font-size: var(--yumi-text-emphasis); line-height: 1.3; color: var(--yumi-ink); }
.contact__body { font-size: var(--yumi-text-caption); line-height: 1.5; color: var(--yumi-muted); }

.page--no-fab { padding-bottom: 64rpx; }
