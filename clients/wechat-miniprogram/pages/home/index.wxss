/* 首页：横幅圆角落在页边内；门店名用宋体大字；房间为左图右文的行，行间用细分隔线，不套卡片框。 */
.banner { display: block; margin-bottom: 48rpx; --td-swiper-radius: 24rpx; }
.banner--placeholder { height: 386rpx; border-radius: 24rpx; background: var(--yumi-surface); }

.store { margin-bottom: 56rpx; }
.store__name { display: block; font-family: var(--yumi-serif); font-weight: 400; font-size: 52rpx; line-height: 1.25; color: var(--yumi-ink); }
.store__intro {
  display: -webkit-box; margin-top: 12rpx; font-size: 28rpx; line-height: 1.7; color: var(--yumi-muted);
  overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
}

.rooms-title { padding-bottom: 8rpx; }
.room { display: flex; gap: 28rpx; padding: 32rpx 0; transition: opacity 0.15s ease-out; }
.room + .room { border-top: 1rpx solid var(--yumi-hairline); }
.room--pressed { opacity: 0.72; }
.room__cover { flex: none; width: 232rpx; height: 232rpx; border-radius: 20rpx; background: var(--yumi-surface); }
.room__cover--empty { display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: var(--yumi-muted); }
.room__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; padding-top: 4rpx; }
.room__name { font-family: var(--yumi-serif); font-weight: 400; font-size: 36rpx; line-height: 1.3; color: var(--yumi-ink); }
.room__summary {
  display: -webkit-box; margin-top: 4rpx; font-size: 26rpx; line-height: 1.6; color: var(--yumi-body);
  overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
}

/* 加载占位与成品同形：横幅块 + 左方块右三条。 */
.room-skeleton { display: flex; gap: 28rpx; padding: 32rpx 0; }
.room-skeleton__lines { flex: 1; }
.room-skeleton__line { height: 26rpx; width: 60%; margin-top: 20rpx; border-radius: 8rpx; background: var(--yumi-surface); }
.room-skeleton__line--title { height: 36rpx; width: 44%; margin-top: 4rpx; }
.room-skeleton__line--long { width: 92%; }
