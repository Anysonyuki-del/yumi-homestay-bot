<import src="../../templates/state.wxml" />
<view class="page">
  <view wx:if="{{status === 'loading'}}" class="cards" aria-label="正在加载服务">
    <view class="card card--placeholder" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this">
      <view class="card__icon"></view>
      <view class="card__line card__line--title"></view>
      <view class="card__line"></view>
    </view>
  </view>
  <template wx:elif="{{status === 'error'}}" is="state" data="{{title: '服务没有加载出来', body: message, actionText: '重试', actionVariant: 'outline'}}" />
  <template wx:elif="{{status === 'empty'}}" is="state" data="{{title: '入住指南正在整理', body: '入住时间、Wi-Fi 这类问题，可以先问管家。', actionText: '问管家', actionIcon: 'chat'}}" />
  <block wx:else>
    <!-- 导航栏已写「服务」，页内不再重复标题（质感 Spec T5）。 -->
    <view class="cards">
      <view class="card pressable" wx:for="{{categories}}" wx:key="name" data-name="{{item.name}}" bindtap="openCategory" hover-class="is-pressed" hover-stay-time="80" aria-role="button" aria-label="{{item.name}}，{{item.count}} 条">
        <view class="card__icon"><t-icon name="{{item.icon}}" size="44rpx" color="#a9583e" /></view>
        <text class="card__name">{{item.name}}</text>
        <text class="card__meta">{{item.count}} 条 · {{item.preview}}</text>
      </view>
    </view>
    <view class="contact pressable" bindtap="askHost" hover-class="is-pressed" hover-stay-time="80" aria-role="button" aria-label="联系管家">
      <view class="contact__text">
        <text class="contact__title">联系管家</text>
        <text class="contact__body">没找到想问的，直接问管家。</text>
      </view>
      <t-icon name="chevron-right" size="40rpx" color="#6c6a64" />
    </view>
  </block>
</view>
