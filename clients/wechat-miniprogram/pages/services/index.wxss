/* 服务：两列纯白细描边分类卡片 + 页尾联系管家条。 */
.cards { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 36rpx; }
.card {
  box-sizing: border-box; width: calc((100% - 20rpx) / 2); min-height: 244rpx;
  display: flex; flex-direction: column; padding: 28rpx;
  border-radius: 24rpx; border: 1rpx solid var(--yumi-hairline); background: var(--yumi-surface);
}
.card__icon {
  display: flex; align-items: center; justify-content: center;
  width: 80rpx; height: 80rpx; margin-bottom: 24rpx; border-radius: 20rpx; background: var(--yumi-surface-well);
}
.card__name {
  display: -webkit-box; font-weight: 700; font-size: var(--yumi-text-emphasis); line-height: 1.35; color: var(--yumi-ink);
  overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
}
.card__meta {
  display: -webkit-box; margin-top: 8rpx; font-size: var(--yumi-text-caption); line-height: 1.5; color: var(--yumi-muted);
  overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
}

.card--placeholder .card__icon { background: var(--yumi-surface-well); }
.card__line { height: 24rpx; width: 80%; margin-top: 12rpx; border-radius: 8rpx; background: var(--yumi-surface-well); }
.card__line--title { height: 32rpx; width: 56%; margin-top: 0; }

.contact {
  display: flex; align-items: center; gap: 24rpx; padding: 28rpx 32rpx;
  border-radius: 24rpx; border: 1rpx solid var(--yumi-hairline); background: var(--yumi-surface);
}
.contact__text { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.contact__title { font-weight: 700; font-size: var(--yumi-text-emphasis); line-height: 1.3; color: var(--yumi-ink); }
.contact__body { font-size: var(--yumi-text-caption); line-height: 1.5; color: var(--yumi-muted); }
