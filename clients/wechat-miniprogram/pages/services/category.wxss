/* 服务分类：纯白细描边折叠问答面板，标题用清晰加粗无衬线，答案留足呼吸感。 */
.qa {
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--yumi-hairline);
  --td-cell-title-font: 600 32rpx / 1.5 var(--yumi-sans);
  --td-collapse-content-padding: 8rpx 32rpx 36rpx;
}
.footnote { display: block; padding: 28rpx 8rpx 0; font-size: var(--yumi-text-caption); color: var(--yumi-muted); }
