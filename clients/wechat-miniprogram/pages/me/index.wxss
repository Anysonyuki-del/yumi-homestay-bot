/* 我的：顶部账号条 + 一组菜单行；菜单在暖奶油底上，行间细分隔线。图标颜色经 t-icon 的 color 属性给出（组件不透传 class）。 */
.account { display: flex; align-items: center; gap: 24rpx; padding: 16rpx 0 48rpx; }
.account__avatar { flex: none; display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--yumi-surface); color: var(--yumi-muted); }
.account__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.account__title { font-family: var(--yumi-serif); font-weight: 400; font-size: 40rpx; line-height: 1.3; color: var(--yumi-ink); }
.account__message { font-size: 26rpx; line-height: 1.5; color: var(--yumi-muted); }

.menu { border-radius: 24rpx; background: var(--yumi-surface-soft); overflow: hidden; }
.menu__row { display: flex; align-items: center; gap: 24rpx; padding: 32rpx; transition: opacity 0.15s ease-out; }
.menu__row + .menu__row { border-top: 1rpx solid var(--yumi-hairline); }
.menu__row--pressed { opacity: 0.6; }
.menu__label { flex: 1; font-size: 30rpx; color: var(--yumi-ink); }
