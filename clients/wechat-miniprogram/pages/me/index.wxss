/* 我的：顶部问候与账号状态 + 细描边切面菜单卡，行间以细线分隔；行首图标继承行的前景强调色。 */
.account { display: flex; align-items: center; gap: 24rpx; padding: 16rpx 0 40rpx; }
.account__action { margin: -8rpx 0 40rpx; }
.account__avatar {
  flex: none; display: flex; align-items: center; justify-content: center;
  width: 108rpx; height: 108rpx; border-radius: 28rpx;
  border: 1rpx solid var(--yumi-hairline); background: var(--yumi-surface);
  box-shadow: var(--yumi-shadow-card); color: var(--yumi-primary-deep);
}
.account__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.account__title { font-weight: 700; font-size: var(--yumi-text-title); line-height: 1.3; color: var(--yumi-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.account__status { font-size: var(--yumi-text-caption); line-height: 1.5; color: var(--yumi-muted); }
.account__message { font-size: var(--yumi-text-caption); line-height: 1.5; color: var(--yumi-primary-deep); }

.menu {
  border-radius: 24rpx; border: 1rpx solid var(--yumi-hairline);
  background: var(--yumi-surface); box-shadow: var(--yumi-shadow-card); overflow: hidden;
}
.menu__row { display: flex; align-items: center; gap: 24rpx; padding: 30rpx 32rpx; color: var(--yumi-primary-deep); transition: background-color 140ms ease-out; }
.menu__row + .menu__row { border-top: 1rpx solid var(--yumi-hairline); }
.menu__row--pressed { background: var(--yumi-surface-well); }
.menu__label { flex: 1; font-size: var(--yumi-text-emphasis); font-weight: 500; color: var(--yumi-ink); }

.logout { margin-top: 40rpx; --td-button-default-color: var(--yumi-muted); }
