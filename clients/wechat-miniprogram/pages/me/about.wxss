/* 关于本店：宋体店名 + 正文简介；地址与电话是两行事实条，可操作的行右侧给出动词。 */
.about__name { display: block; font-family: var(--yumi-serif); font-weight: 400; font-size: 48rpx; line-height: 1.25; color: var(--yumi-ink); margin-bottom: 24rpx; }
.about__intro { display: block; margin-bottom: 48rpx; }
.facts { border-radius: 24rpx; background: var(--yumi-surface-soft); overflow: hidden; }
.fact { display: flex; align-items: center; gap: 24rpx; padding: 32rpx; transition: opacity 0.15s ease-out; }
.fact + .fact { border-top: 1rpx solid var(--yumi-hairline); }
.fact--pressed { opacity: 0.6; }
.fact__text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.fact__label { font-size: 24rpx; color: var(--yumi-muted); }
.fact__value { font-size: 30rpx; line-height: 1.5; color: var(--yumi-ink); }
.fact__action { flex: none; font-size: 26rpx; color: var(--yumi-primary-deep); }
