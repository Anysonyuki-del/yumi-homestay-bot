<view class="page">
  <!-- 头部用问候开头，登录状态降为一行小字（质感 Spec T6）。 -->
  <view class="account">
    <view class="account__avatar" aria-hidden="true"><t-icon name="user" size="56rpx" /></view>
    <view class="account__main">
      <text class="account__title">你好，欢迎入住</text>
      <text class="account__status">{{authStatus === 'logged_in' ? '已用微信登录' : authStatus === 'unknown' ? '登录状态待确认' : authStatus === 'checking' ? '正在确认登录状态' : '微信未登录'}}</text>
      <text wx:if="{{authMessage}}" class="account__message" aria-live="polite">{{authMessage}}</text>
    </view>
  </view>
  <!-- 登录按钮不和问候挤在一行：微信按钮自带固定宽度，同行会把问候挤成两行（预览发现）。
       未登录、待确认时按钮放在头部下方整行；已登录时「退出登录」放到菜单之后。 -->
  <view wx:if="{{authStatus === 'logged_out'}}" class="account__action">
    <!-- 登录本期不解锁任何功能，用描边按钮，把视觉重心让给下方的联系管家与查订单（到店体验 Spec R4）。 -->
    <t-button theme="primary" variant="outline" block shape="round" loading="{{authBusy}}" disabled="{{authBusy}}" bind:tap="handleLogin">微信登录</t-button>
  </view>
  <view wx:elif="{{authStatus === 'unknown'}}" class="account__action">
    <t-button theme="primary" variant="outline" block shape="round" loading="{{authBusy}}" disabled="{{authBusy}}" bind:tap="restoreLogin">重新确认登录</t-button>
  </view>

  <view class="menu">
    <!-- 原生客服按钮：客服会话只能由客人点按钮直接打开（客服按钮 Spec C1）。 -->
    <button class="contact-reset menu__row" open-type="contact" session-from="me" hover-class="menu__row--pressed" hover-stay-time="80" aria-label="联系管家">
      <t-icon name="chat" size="44rpx" />
      <text class="menu__label">联系管家</text>
      <t-icon name="chevron-right" size="40rpx" t-class="yumi-chevron" />
    </button>
    <!-- 订单咨询（到店体验 Spec R4）：原来的「我的订单 · 即将开放」只弹提示，客人还要再找客服；
         改为原生客服按钮，登录前后都一次点击问管家。自助查单另议：展示订单前必须核实归属，
         不能按微信登录或客人自报手机号自动关联（三标签 Spec D1）。 -->
    <button class="contact-reset menu__row" open-type="contact" session-from="orders" hover-class="menu__row--pressed" hover-stay-time="80" aria-label="向管家查订单">
      <t-icon name="order" size="44rpx" />
      <text class="menu__label">向管家查订单</text>
      <t-icon name="chevron-right" size="40rpx" t-class="yumi-chevron" />
    </button>
    <view class="menu__row" bindtap="openAbout" hover-class="menu__row--pressed" hover-stay-time="80" aria-role="button">
      <t-icon name="shop" size="44rpx" />
      <text class="menu__label">关于本店</text>
      <t-icon name="chevron-right" size="40rpx" t-class="yumi-chevron" />
    </view>
  </view>

  <view wx:if="{{authStatus === 'logged_in'}}" class="logout">
    <t-button variant="text" block loading="{{authBusy}}" disabled="{{authBusy}}" bind:tap="handleLogout">退出登录</t-button>
  </view>
</view>
