# 数据库连接地址，例如 postgresql+asyncpg://homestay:password@postgres:5432/homestay
DATABASE_URL=

# 本地 HTTPS 隧道提供的公网根地址
PUBLIC_BASE_URL=

# OpenAI 配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra

# 百居易 OpenAPI 配置
HOSTEX_ACCESS_TOKEN=

# 企业微信微信客服与内部应用配置
WECOM_CORP_ID=
WECOM_KF_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=
# 值班员工 userid，多个用英文逗号分隔
WECOM_DUTY_USERIDS=
# 回调丢失时的客服消息补拉间隔，单位秒
WECOM_POLL_INTERVAL_SECONDS=15

# 员工网页登录签名密钥，本地也请使用至少 32 位随机字符串
SESSION_SECRET=

# 真实契约测试默认关闭
RUN_LIVE_CONTRACT_TESTS=0
# 收到一条专用测试客服回调后，临时填入以下两项执行只读契约测试
WECOM_TEST_SYNC_TOKEN=
WECOM_TEST_OPEN_KFID=
