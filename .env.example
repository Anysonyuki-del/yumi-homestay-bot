# 数据库连接地址，例如 postgresql+asyncpg://homestay:password@postgres:5432/homestay
DATABASE_URL=

# 本地 HTTPS 隧道提供的公网根地址
PUBLIC_BASE_URL=

# DeepSeek 配置
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 百居易 OpenAPI 配置
HOSTEX_ACCESS_TOKEN=
# 在百居易 Webhook 配置中设置的共享 Secret
HOSTEX_WEBHOOK_SECRET_TOKEN=
# Webhook 补漏对账间隔，默认 15 分钟
HOSTEX_RECONCILE_INTERVAL_SECONDS=900

# 企业微信微信客服与内部应用配置
WECOM_CORP_ID=
WECOM_KF_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=
# 可选：企业微信“客户联系”Secret；配置后才同步外部联系人标签
WECOM_CONTACT_SECRET=
# 值班员工 userid，多个用英文逗号分隔
WECOM_DUTY_USERIDS=
# 回调丢失时的客服消息补拉间隔，单位秒
WECOM_POLL_INTERVAL_SECONDS=60

# 员工网页登录签名密钥，本地也请使用至少 32 位随机字符串
SESSION_SECRET=

# 客户手机号、门锁密码等敏感数据的独立 Fernet 密钥
# 可运行：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# 员工任务现场照片的服务器私有目录与单张大小上限
PRIVATE_UPLOAD_DIR=data/private_uploads
PRIVATE_UPLOAD_MAX_BYTES=10485760

# 真实契约测试默认关闭
RUN_LIVE_CONTRACT_TESTS=0
# 收到一条专用测试客服回调后，临时填入以下两项执行只读契约测试
WECOM_TEST_SYNC_TOKEN=
WECOM_TEST_OPEN_KFID=
